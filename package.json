{
  "name": "portfolio-2026",
  "private": true,
  "version": "1.0.0",
  "description": "Personal portfolio for Eivinas Norušaitis — static Astro site, eivinasn.com",
  "homepage": "https://eivinasn.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heshipstech/2026-portfolio.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-htaccess.mjs",
    "preview": "astro preview",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:htaccess": "node scripts/generate-htaccess.mjs",
    "verify:csp": "node scripts/verify-csp.mjs",
    "measure:perf": "node scripts/measure-perf.mjs",
    "generate:fonts": "node scripts/subset-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro sync && astro check",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run build && npm run validate:html && npm run check:links && npm run verify:a11y && npm run verify:csp && npm run measure:perf",
    "smoke": "node scripts/smoke-deploy.mjs",
    "ping:indexnow": "node scripts/ping-indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "axe-core": "^4.13.0",
    "html-validate": "^11.6.2",
    "linkinator": "^8.0.3",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
