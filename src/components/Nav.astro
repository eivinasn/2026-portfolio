---
const { showCta = true } = Astro.props;
---

<div class="fixed flex z-50 pt-4 pr-4 pl-4 top-0 right-0 left-0 justify-center">
  <nav class="flex glass-panel transition-all duration-300 w-full max-w-5xl rounded-full pt-3 pr-6 pb-3 pl-6 relative shadow-2xl items-center justify-between">
    <div class="flex items-center gap-4">
      <button class="md:hidden p-1 text-white hover:text-[#A1A1AA] transition-colors" aria-label="Open menu" aria-controls="mobile-nav" aria-expanded="false" data-nav-toggle>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
      <a href="/" class="flex items-center justify-center w-8 h-8 transition-opacity hover:opacity-80" aria-label="Home">
        <img src="/logo-eivinas.svg" alt="Eivinas Norusaitis logo" class="w-full h-full object-contain" />
      </a>
    </div>

    <div class="hidden md:flex -translate-x-1/2 -translate-y-1/2 gap-8 absolute top-1/2 left-1/2 gap-x-8 gap-y-8 items-center">
      <a href="/#about" class="text-xs font-medium text-[#A1A1AA] hover:text-white transition-colors">About me</a>
      <a href="/#work" class="text-xs font-medium text-[#A1A1AA] hover:text-white transition-colors">Case Studies</a>
      <a href="/#timeline" class="text-xs font-medium text-[#A1A1AA] hover:text-white transition-colors">Timeline</a>
      <a href="/#competencies" class="text-xs font-medium text-[#A1A1AA] hover:text-white transition-colors">Philosophy</a>
    </div>

    <div class="flex items-center gap-4">
      <div class="hidden md:flex gap-4 border-[#27272A] border-r mr-1 pr-4 gap-x-4 gap-y-4 items-center">
        <a href="https://www.linkedin.com/in/eivinasnorusaitis/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer" class="text-[#A1A1AA] hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="lucide lucide-linkedin w-[16px] h-[16px]">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a href="mailto:e.norusaitis@gmail.com" aria-label="Send email" class="text-[#A1A1AA] hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="lucide lucide-mail w-[16px] h-[16px]">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
          </svg>
        </a>
      </div>

      {showCta && (
        <a href="https://calendar.app.google/EWYCBWvgG54Y7qp49" target="_blank" rel="noopener noreferrer" class="hidden md:flex hover:bg-[#1e40af] text-[11px] transition-colors font-semibold text-white bg-[#1d4ed8] rounded-full pt-1.5 pr-4 pb-1.5 pl-4 shadow-[0_0_15px_rgba(29,78,216,0.3)]">
          Book a call
        </a>
      )}

      <!-- Mobile right-side icons + CTA -->
      <div class="md:hidden flex items-center gap-3">
        <a href="https://www.linkedin.com/in/eivinasnorusaitis/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer" class="text-[#A1A1AA] hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="lucide lucide-linkedin w-[16px] h-[16px]">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a href="mailto:e.norusaitis@gmail.com" aria-label="Send email" class="text-[#A1A1AA] hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="lucide lucide-mail w-[16px] h-[16px]">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
          </svg>
        </a>
        {showCta && (
          <a href="https://calendar.app.google/EWYCBWvgG54Y7qp49" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center hover:bg-[#1e40af] text-[11px] transition-colors font-semibold text-white bg-[#1d4ed8] rounded-full py-1 px-3 shadow-[0_0_15px_rgba(29,78,216,0.3)]">
            Book a call
          </a>
        )}
      </div>
    </div>

    <!-- Mobile dropdown -->
    <div id="mobile-nav" class="md:hidden absolute top-full left-0 right-0 mt-2 hidden z-50">
      <div class="rounded-2xl p-4 shadow-2xl bg-[#0b0b0b] border border-[#27272A]">
        <div class="flex flex-col gap-3">
          <a href="/#about" class="text-sm font-medium text-[#A1A1AA] hover:text-white transition-colors">About me</a>
          <a href="/#work" class="text-sm font-medium text-[#A1A1AA] hover:text-white transition-colors">Case Studies</a>
          <a href="/#timeline" class="text-sm font-medium text-[#A1A1AA] hover:text-white transition-colors">Timeline</a>
          <a href="/#competencies" class="text-sm font-medium text-[#A1A1AA] hover:text-white transition-colors">Philosophy</a>
        </div>

        <div class="mt-4 flex items-center gap-4">
          <a href="https://www.linkedin.com/in/eivinasnorusaitis/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer" class="text-[#A1A1AA] hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="lucide lucide-linkedin w-[18px] h-[18px]">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href="mailto:e.norusaitis@gmail.com" aria-label="Send email" class="text-[#A1A1AA] hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="lucide lucide-mail w-[18px] h-[18px]">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
            </svg>
          </a>
        </div>

        {showCta && (
          <a href="https://calendar.app.google/EWYCBWvgG54Y7qp49" target="_blank" rel="noopener noreferrer" class="mt-4 w-full inline-flex items-center justify-center hover:bg-[#1e40af] text-[12px] transition-colors font-semibold text-white bg-[#1d4ed8] rounded-full py-2 shadow-[0_0_15px_rgba(29,78,216,0.3)]">
            Book a call
          </a>
        )}
      </div>
    </div>
  </nav>
</div>

<script>
  // Mobile menu toggle.
  //
  // The panel is not adjacent to its trigger in DOM order, so focus is moved
  // explicitly on open and returned to the trigger on Escape. Without that, a
  // keyboard user opens the menu and their focus is still back on the button
  // with the links several stops away.
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.querySelector('[data-nav-toggle]');
    const mobilePanel = document.getElementById('mobile-nav');

    if (!toggleButton || !mobilePanel) return;

    const isOpen = () => !mobilePanel.classList.contains('hidden');

    const setOpen = (open, returnFocus) => {
      mobilePanel.classList.toggle('hidden', !open);
      toggleButton.setAttribute('aria-expanded', String(open));
      if (open) {
        mobilePanel.querySelector('a')?.focus();
      } else if (returnFocus) {
        toggleButton.focus();
      }
    };

    toggleButton.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    // Following a link inside the panel should dismiss it.
    mobilePanel.addEventListener('click', (e) => {
      if (e.target.closest('a')) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      if (!mobilePanel.contains(e.target) && !toggleButton.contains(e.target)) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false, true);
    });
  });
</script>
