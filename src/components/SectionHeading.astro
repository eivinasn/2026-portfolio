---
const { overline, title } = Astro.props;
---

<div class="reveal-on-scroll">
  <span
    class="text-[11px] font-semibold text-[#A1A1AA] block mb-4 border-b border-[#27272A] w-fit pb-1 uppercase tracking-wider"
  >
    {overline}
  </span>
  <h2 class="text-3xl md:text-5xl font-semibold text-white tracking-tight">
    {title}
  </h2>
</div>
