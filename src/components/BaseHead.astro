---
// Single source of truth for document metadata.
//
// Both layouts render this. Before increment 1 they each carried their own
// hand-written <head>, which is why the canonical placeholder was fixed in one
// place and absent in the other.
//
// Canonical URLs are derived from Astro.site + the current path and always end
// in a trailing slash, matching the 301 the server already performs.
import StructuredData from './StructuredData.astro';
import Analytics from './Analytics.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-image.png',
  type = 'website',
  noindex = false
} = Astro.props as Props;

const path = Astro.url.pathname.replace(/\/+$/, '');
const canonical = new URL(path === '' ? '/' : `${path}/`, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="theme-color" content="#050505" />
<meta name="author" content="Eivinas Norušaitis" />

{
  noindex ? (
    /* No canonical on a noindex page: /404 has no indexable URL to point at. */
    <meta name="robots" content="noindex, follow" />
  ) : (
    <link rel="canonical" href={canonical} />
  )
}

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/logo-eivinas.svg" type="image/svg+xml" />
<!-- PNG, not SVG: iOS silently ignores an SVG apple-touch-icon. -->
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Eivinas Norušaitis" />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Eivinas Norušaitis — Design, Ops & Leadership. Portfolio 2026." />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={imageUrl} />

<StructuredData
  type={type === 'article' ? 'case-study' : 'home'}
  title={title}
  description={description}
  url={canonical}
  image={imageUrl}
/>

<!--
  Without JavaScript, ~20 homepage blocks stay at opacity:0 forever and mobile
  has no navigation at all. This is the fallback. Increment 5 must include this
  block's hash in style-src.
-->
<noscript>
  <style>
    .reveal-on-scroll,
    .reveal-opacity-only,
    .animate-fade-up,
    .fade-in {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    @media (max-width: 767px) {
      /* Show the menu in its open state and drop the toggle that cannot work. */
      #mobile-nav {
        display: block !important;
      }
      [data-nav-toggle] {
        display: none !important;
      }
    }
  </style>
</noscript>

<Analytics />

<!-- Inter is self-hosted (src/styles/global.css). Preload only the latin subset:
     latin-ext carries a single glyph on this site and is not on the critical
     path. -->
<link
  rel="preload"
  href="/fonts/inter-latin-var.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
