---
// Replaces Hostinger's stock error page, which loads Google Analytics, Google
// Tag Manager and doubleclick.net under the eivinasn.com origin with no consent
// banner — none of them the owner's. See QUESTIONS.md Q13.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Case Studies' },
  { href: '/#about', label: 'About me' },
  { href: '/#contact', label: 'Get in touch' }
];
---

<Layout
  title="Page not found - Eivinas Norušaitis"
  description="That page does not exist. Head back to the portfolio."
  noindex
>
  <header>
    <Nav />
  </header>

  <main id="main" class="w-full mt-32 md:mt-40">
    <section class="max-w-7xl mx-auto px-4 md:px-8 py-24 md:py-40">
      <span
        class="text-[11px] font-semibold text-[#8a8a94] mb-6 border-b border-[#27272A] pb-1 uppercase tracking-wider inline-block"
      >
        Error 404
      </span>
      <h1
        class="text-5xl md:text-7xl font-semibold text-white tracking-tighter leading-[0.95] mb-8"
      >
        This page<br /><span class="text-[#5b5b65]">does not exist.</span>
      </h1>
      <p class="text-lg md:text-xl text-[#A1A1AA] max-w-xl leading-relaxed mb-12">
        The link may be out of date, or the address mistyped. Everything below is still where you
        left it.
      </p>

      <nav aria-label="Recovery links" class="flex flex-wrap gap-3">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="inline-flex items-center gap-2 border border-[#5b5b65] text-[#A1A1AA] px-5 py-2.5 rounded-full text-[13px] font-medium hover:border-[#3b82f6] hover:text-white transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </section>
  </main>

  <Footer />
</Layout>
