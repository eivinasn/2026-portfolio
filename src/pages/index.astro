---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />

  <main class="w-full mt-32 md:mt-40">
    <section class="md:px-8 md:mb-32 max-w-7xl mr-auto mb-24 ml-auto pr-4 pl-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center">
        <div class="lg:col-span-7 flex flex-col items-start">
          <span class="text-[11px] font-semibold text-[#A1A1AA] mb-6 border-b border-[#27272A] pb-1 uppercase tracking-wider animate-fade-up" style="animation-delay: 0.1s;">
            Portfolio 2026
          </span>
          <h1 class="md:text-7xl lg:text-8xl leading-[0.95] text-5xl font-semibold text-white tracking-tighter mb-8 animate-fade-up" style="animation-delay: 0.2s;">
            Product Design,<br />
            <span class="text-[#52525B]">Ops &amp; Leadership.</span>
          </h1>
          <p class="text-xl md:text-2xl text-[#A1A1AA] max-w-2xl leading-relaxed mb-10 font-medium animate-fade-up" style="animation-delay: 0.3s">
            12+ years operating at scale. Moving toward early-stage company building. Turning complexity into clear direction.
          </p>
          <div class="flex flex-wrap gap-4 animate-fade-up" style="animation-delay: 0.4s">
            <a href="#work" class="group flex items-center gap-2 bg-[#1d4ed8] px-6 py-3 rounded-full text-[13px] font-medium hover:bg-[#1e40af] transition-colors text-white shadow-[0_0_15px_rgba(29,78,216,0.3)]">
              View Case Studies
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="14" height="14" viewBox="0 0 24 24" class="group-hover:translate-x-1 transition-transform">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-7-7l7 7l-7 7"></path>
              </svg>
            </a>
            <a href="#contact" class="group flex items-center gap-2 border border-[#3F3F46] text-[#A1A1AA] px-6 py-3 rounded-full text-[13px] font-medium hover:border-[#1d4ed8] hover:text-white transition-colors bg-transparent">
              Get in Touch
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 w-full max-w-md mx-auto lg:max-w-none">
          <div class="aspect-[3/4] rounded-2xl bg-[#121212] border border-[#27272A] flex items-center justify-center relative overflow-hidden group">
            <div class="absolute inset-0 h-full w-full">
              <img src="/public/hero-portrait.png" alt="Eivinas Norušaitis" class="h-full w-full object-cover grayscale transition-all duration-500 ease-out group-hover:scale-105 group-hover:grayscale-0" />
              <div class="bg-gradient-to-b from-transparent to-black/40 absolute inset-0"></div>
            </div>
            <div class="flex flex-col items-center gap-3 text-[#52525B]">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="48" height="48" viewBox="0 0 24 24">
                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                  <circle cx="9" cy="9" r="2"></circle>
                  <path d="m21 15l-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                </g>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#0A0A0A] border-[#27272A] border-t" id="about">
      <div class="max-w-7xl mx-auto px-4 md:px-8 py-20 md:py-32 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24">
        <div class="md:col-span-4 reveal-on-scroll">
          <span class="text-[11px] font-semibold text-[#A1A1AA] block mb-4 border-b border-[#27272A] w-fit pb-1 uppercase tracking-wider">
            01 — Executive Summary
          </span>
          <h2 class="text-3xl font-semibold text-white tracking-tight leading-tight">
            From hands-on craft to operational scale.
          </h2>
        </div>
        <div class="md:col-span-8 space-y-6 text-[#A1A1AA] leading-relaxed text-base md:text-lg reveal-on-scroll delay-100">
          <p>
            I’m a senior product and design leader with over 12 years of experience working across organizations. My career began in hands-on product design and gradually expanded into leadership roles with responsibility for teams, operations, and business results, across both consumer and enterprise products.
          </p>
          <div class="pl-6 border-l border-[#27272A] space-y-4 my-8">
            <div class="flex gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 text-[#1d4ed8] mt-1">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5"></path>
              </svg>
              <p class="text-sm md:text-base">
                Designing payment and transaction flows as a product designer in a high-growth startup environment that had already reached unicorn scale.
              </p>
            </div>
            <div class="flex gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 text-[#1d4ed8] mt-1">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5"></path>
              </svg>
              <p class="text-sm md:text-base">
                Leading and running a dedicated design unit with full financial ownership, including P&amp;L responsibility, resourcing, and commercial decision-making.
              </p>
            </div>
            <div class="flex gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 text-[#1d4ed8] mt-1">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5"></path>
              </svg>
              <p class="text-sm md:text-base">
                Leading an EU-based product design studio, working closely with leadership across Europe and the US within a global, regulated healthtech organization.
              </p>
            </div>
          </div>
          <p>
            Across these roles, I worked on turning complexity into clear direction—shaping product decisions, aligning teams across design, engineering, and leadership, and making sure outcomes made sense both operationally and commercially.
          </p>
        </div>
      </div>
    </section>

    <section class="overflow-hidden bg-[#050505] border-[#27272A] border-b pt-16 pb-16">
      <div class="md:px-8 reveal-on-scroll max-w-7xl mr-auto ml-auto pr-4 pl-4">
        <p class="text-[10px] uppercase md:text-left font-semibold text-[#52525B] tracking-wider text-center mb-8">
          Organizations
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 items-center">
          <div class="col-span-2 md:col-span-3 lg:col-span-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 w-full">
            <img src="/public/logo-dexcom.svg" alt="Dexcom Logo" class="max-h-[24px] w-full object-contain opacity-50 hover:opacity-100 transition-opacity cursor-pointer" />
            <img src="/public/logo-nfq.svg" alt="NFQ Logo" class="max-h-[24px] w-full object-contain opacity-50 hover:opacity-100 transition-opacity cursor-pointer" />
            <img src="/public/logo-vinted.svg" alt="Vinted Logo" class="max-h-[24px] w-full object-contain opacity-50 hover:opacity-100 transition-opacity cursor-pointer" />
            <img src="/public/logo-tieto.svg" alt="Tieto Logo" class="max-h-[24px] w-full object-contain opacity-50 hover:opacity-100 transition-opacity cursor-pointer" />
            <img src="/public/logo-ba.svg" alt="Baltic Amadeus Logo" class="max-h-[24px] w-full object-contain opacity-50 hover:opacity-100 transition-opacity cursor-pointer" />
            <img src="/public/logo-pitchero.svg" alt="Pitchero Logo" class="max-h-[24px] w-full object-contain opacity-50 hover:opacity-100 transition-opacity cursor-pointer" />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#050505] pt-24 pb-24" id="work">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6 reveal-on-scroll">
          <SectionHeading overline="02 — Work" title="Leadership & Case Studies" />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <CaseStudyCard href="/work/dexcom" tag="Global Leadership" title="Dexcom — Team Building" description="Building and leading an EU-based design studio while aligning execution and decision-making across EU and US leadership." imageUrl="/public/thumb-dexcom.png" />
          <CaseStudyCard href="/work/nfq" tag="Business Unit" title="NFQ — Operational Design" description="Running design as a business unit, scaling revenue to ~0.5M within a year through operational ownership and commercial focus." imageUrl="/public/thumb-nfq.png" delay="delay-100" />
          <CaseStudyCard href="/work/vmi" tag="Public Sector" title="VMI — Tax Declaration" description="Redesigning a national tax declaration system, increasing annual taxpayer participation by 500k+ users." imageUrl="/public/thumb-vmi.png" />
          <CaseStudyCard href="/work/vinted" tag="Fintech" title="Vinted — Monetization" description="Designing monetization and payment flows for millions of users during market rollout." imageUrl="/public/thumb-vinted.png" delay="delay-100" />
        </div>
      </div>
    </section>

    <section class="py-12 border-b border-[#27272A] bg-[#0A0A0A]">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="w-full">
          <p class="text-[10px] uppercase tracking-wider text-[#52525B] mb-8 text-center md:text-left font-semibold">Industries</p>
          <div class="flex flex-wrap gap-3 justify-center md:justify-start items-center">
            <span class="text-[11px] hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default font-medium text-[#A1A1AA] bg-[#121212] border-[#27272A] border rounded-full px-3 py-1.5 shadow-sm">Consumer Platforms</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">B2B SaaS</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">Payments</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">Healthtech</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">Public Sector</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">Insurance</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">eBanking</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">eCommerce</span>
            <span class="px-3 py-1.5 rounded-full border border-[#27272A] text-[11px] font-medium text-[#A1A1AA] shadow-sm hover:border-[#1d4ed8] hover:text-[#1d4ed8] transition-colors cursor-default bg-[#121212]">Logistics</span>
          </div>
        </div>
      </div>
    </section>

    <section id="timeline" class="py-24 border-t border-[#27272A]">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="mb-16 reveal-on-scroll">
          <span class="text-[11px] font-semibold text-[#A1A1AA] block mb-4 border-b border-[#27272A] w-fit pb-1 uppercase tracking-wider">
            03 — Career
          </span>
          <h2 class="text-3xl md:text-5xl font-semibold text-white tracking-tight">Evolution Timeline</h2>
        </div>
        <div class="relative space-y-16">
          <div class="w-px bg-[#27272A] absolute top-3 bottom-0 left-[5.5px]"></div>
          <div class="md:pl-12 group pl-8 relative reveal-on-scroll">
            <div class="absolute left-0 top-1.5 w-3 h-3 bg-[#1d4ed8] rounded-full ring-4 ring-[#050505]"></div>
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-3">
              <h3 class="text-xl font-semibold text-white">Phase V — Building the Next Chapter</h3>
              <span class="text-[10px] font-semibold text-[#1d4ed8] uppercase tracking-wide">Future</span>
            </div>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed">
              I’m actively preparing for a transition into early-stage company building. After years of operating within mature organizations, my focus is now on applying this experience where early decisions shape long-term outcomes.
            </p>
          </div>
          <div class="relative pl-8 md:pl-12 group reveal-on-scroll">
            <div class="absolute left-0 top-1.5 w-3 h-3 bg-[#52525B] group-hover:bg-white transition-colors rounded-full ring-4 ring-[#050505]"></div>
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-3">
              <h3 class="text-xl font-semibold text-white">Phase IV — Global Leadership</h3>
              <span class="text-[10px] font-semibold text-[#71717A] uppercase tracking-wide">Present</span>
            </div>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed mb-4">
              At <span class="text-white">Dexcom</span>, I lead a 10-person product design studio and serve on the Global Product Design leadership team.
            </p>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed">
              Responsibilities include operational oversight, cross-regional coordination, and long-term capability development.
            </p>
          </div>
          <div class="relative pl-8 md:pl-12 group reveal-on-scroll">
            <div class="absolute left-0 top-1.5 w-3 h-3 bg-[#52525B] group-hover:bg-white transition-colors rounded-full ring-4 ring-[#050505]"></div>
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-3">
              <h3 class="text-xl font-semibold text-white">Phase III — Operational Leadership</h3>
              <span class="text-[10px] font-semibold text-[#71717A] uppercase tracking-wide">2020—2024</span>
            </div>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed mb-4">
              At <span class="text-white">NFQ</span>, I progressed from Lead Designer to Head of UX & Design with P&amp;L accountability.
            </p>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed">
              Balanced quality, speed, and business sustainability while positioning design as a measurable contributor.
            </p>
          </div>
          <div class="relative pl-8 md:pl-12 group reveal-on-scroll">
            <div class="absolute left-0 top-1.5 w-3 h-3 bg-[#52525B] group-hover:bg-white transition-colors rounded-full ring-4 ring-[#050505]"></div>
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-3">
              <h3 class="text-xl font-semibold text-white">Phase II — Designing for Scale</h3>
              <span class="text-[10px] font-semibold text-[#71717A] uppercase tracking-wide">2019—2020</span>
            </div>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed mb-4">
              At <span class="text-white">Vinted</span>, I worked on market monetization and payments in a startup operating at unicorn scale.
            </p>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed">
              Shifted from feature-level delivery to system-level thinking.
            </p>
          </div>
          <div class="relative pl-8 md:pl-12 group reveal-on-scroll">
            <div class="absolute left-0 top-1.5 w-3 h-3 bg-[#52525B] group-hover:bg-white transition-colors rounded-full ring-4 ring-[#050505]"></div>
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-3">
              <h3 class="text-xl font-semibold text-white">Phase I — Foundation of Craft</h3>
              <span class="text-[10px] font-semibold text-[#71717A] uppercase tracking-wide">2012—2017</span>
            </div>
            <p class="text-sm text-[#A1A1AA] max-w-3xl leading-relaxed">
              I began my career at Pitchero, combining product design with HTML/CSS development, later consulting across multiple B2B and B2C industries.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="competencies" class="py-24 border-t border-[#27272A] bg-[#0A0A0A]">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="mb-16 reveal-on-scroll">
          <span class="text-[11px] font-semibold text-[#A1A1AA] block mb-4 border-b border-[#27272A] w-fit pb-1 uppercase tracking-wider">
            04 — Philosophy
          </span>
          <h2 class="text-3xl md:text-5xl font-semibold text-white tracking-tight">How I Operate</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
          <div class="space-y-8 reveal-on-scroll">
            <div class="flex items-center gap-3 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="20" height="20" viewBox="0 0 24 24" class="text-[#1d4ed8]">
                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                  <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path>
                  <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path>
                  <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path>
                </g>
              </svg>
              <h3 class="text-lg font-bold font-heading uppercase tracking-wide">Competencies</h3>
            </div>
            <ul class="space-y-6">
              <li class="leading-relaxed text-sm text-[#A1A1AA]">
                <strong class="text-white block mb-1 font-semibold">Running a business unit</strong>
                Led a dedicated design unit with full financial responsibility—owning budget, revenue, resourcing, and trade-offs.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Product design strategy</strong>
                Set product direction by turning user insights and constraints into clear decisions.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Building and scaling teams</strong>
                Grew design from small groups into stable functions—hiring, defining roles, and creating clear growth paths.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Getting things done across silos</strong>
                Worked closely with engineering, product, sales, and executives to align priorities and move work forward.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Measuring what matters</strong>
                Defined success metrics for both products and people to make prioritization calls.
              </li>
            </ul>
          </div>
          <div class="space-y-8 reveal-on-scroll delay-100">
            <div class="flex items-center gap-3 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="20" height="20" viewBox="0 0 24 24" class="text-[#1d4ed8]">
                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                  <path d="M14 17H5M19 7h-9"></path>
                  <circle cx="17" cy="17" r="3"></circle>
                  <circle cx="7" cy="7" r="3"></circle>
                </g>
              </svg>
              <h3 class="text-lg font-bold font-heading uppercase tracking-wide">Operating Principles</h3>
            </div>
            <ul class="space-y-6">
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Accountability over roles</strong>
                Focus on outcomes, not job descriptions—what matters is whether the decision moves the product forward.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Solve the right problem first</strong>
                Invest time upfront to clarify what we’re actually trying to solve before committing people.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Design systems, not heroics</strong>
                Build structures, processes, and decision frameworks so teams can perform consistently.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Make trade-offs explicit</strong>
                Surface constraints early and choose progress over perfection when needed.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Protect focus</strong>
                Be deliberate about what not to do, so teams can spend energy on what matters.
              </li>
            </ul>
          </div>
          <div class="space-y-8 reveal-on-scroll delay-200">
            <div class="flex items-center gap-3 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="20" height="20" viewBox="0 0 24 24" class="text-[#1d4ed8]">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676a.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052a2.12 2.12 0 0 0-.004-3a2.124 2.124 0 1 0 3-3a2.124 2.124 0 0 0 3.004 0a2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0a2 2 0 0 1 0-2.828l2.823-2.762"></path>
            </svg>
              <h3 class="text-lg font-bold font-heading uppercase tracking-wide">Personal Values</h3>
            </div>
            <ul class="space-y-6">
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Clarity and honesty</strong>
                Direct communication and saying what’s really going on, even when it’s uncomfortable.
              </li>
              <li class="text-sm text-[#A1A1AA] leading-relaxed">
                <strong class="text-white block mb-1 font-semibold">Ownership</strong>
                Take responsibility when things go wrong and give credit when things go right.
              </li>
