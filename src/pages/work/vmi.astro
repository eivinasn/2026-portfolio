---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
---

<CaseStudyLayout
  title="VMI — Tax Declaration"
  summary="Redesigning a national tax declaration system, increasing annual taxpayer participation by 500k+ users."
  role="Product Designer"
  timeline="2017—2018"
  platform="Web"
>
  <section class="fade-in group border-t border-white/5 pt-12" style="animation-delay: 0.2s;">
    <div class="flex flex-col md:flex-row gap-8 md:gap-24">
      <div class="md:w-48 flex-shrink-0 pt-1">
        <span class="text-xs font-medium text-[#52525B] uppercase tracking-wider">Overview</span>
      </div>
      <div class="w-full space-y-8">
        <h2 class="text-2xl font-medium text-[#EDEDED] tracking-tight">Executive summary</h2>
        <p class="text-lg leading-8 text-[#A1A1AA] max-w-3xl">
          Simplified a complex government flow with clearer language, progressive disclosure, and robust validation feedback.
        </p>
        <div class="pt-4">
          <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=2400&q=80" alt="Final Results" class="w-full rounded bg-[#111] border border-white/10 transition-all duration-700 hover:border-white/20" />
        </div>
      </div>
    </div>
  </section>

  <section class="fade-in group border-t border-white/5 pt-12" style="animation-delay: 0.3s;">
    <div class="flex flex-col md:flex-row gap-8 md:gap-24">
      <div class="md:w-48 flex-shrink-0 pt-1"><span class="text-xs font-medium text-[#52525B] uppercase tracking-wider">Result</span></div>
      <div class="w-full space-y-8">
        <h2 class="text-2xl font-medium text-[#EDEDED] tracking-tight">Outcome & impact</h2>
        <ul class="space-y-3 text-[16px] text-[#A1A1AA]">
          <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#EDEDED]"></span><span>500k+ additional annual submissions</span></li>
          <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#EDEDED]"></span><span>Reduced help desk tickets related to flow confusion</span></li>
        </ul>
      </div>
    </div>
  </section>
</CaseStudyLayout>

