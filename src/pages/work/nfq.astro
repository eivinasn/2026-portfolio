---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
---

<CaseStudyLayout
  title="NFQ — Operational Design"
  summary="Running design as a business unit, scaling revenue to ~0.5M within a year through operational ownership and commercial focus."
  role="Head of UX & Design"
  timeline="2020—2024"
  platform="B2B & B2C Web"
>
  <section class="fade-in group border-t border-white/5 pt-12" style="animation-delay: 0.2s;">
    <div class="flex flex-col md:flex-row gap-8 md:gap-24">
      <div class="md:w-48 flex-shrink-0 pt-1">
        <span class="text-xs font-medium text-[#52525B] uppercase tracking-wider">Overview</span>
      </div>
      <div class="w-full space-y-8">
        <h2 class="text-2xl font-medium text-[#EDEDED] tracking-tight">Executive summary</h2>
        <p class="text-lg leading-8 text-[#A1A1AA] max-w-3xl">
          Shifted design from a cost center to a revenue-contributing unit with clear accountability, pricing, and prioritization.
        </p>
      </div>
    </div>
  </section>

  <section class="fade-in group border-t border-white/5 pt-12" style="animation-delay: 0.3s;">
    <div class="flex flex-col md:flex-row gap-8 md:gap-24">
      <div class="md:w-48 flex-shrink-0 pt-1"><span class="text-xs font-medium text-[#52525B] uppercase tracking-wider">Task</span></div>
      <div class="w-full space-y-8">
        <h2 class="text-2xl font-medium text-[#EDEDED] tracking-tight">Goals & objectives</h2>
        <ul class="space-y-3 text-[16px] text-[#A1A1AA]">
          <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#EDEDED] mt-2"></span><span>Introduce P&amp;L responsibility</span></li>
          <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#EDEDED] mt-2"></span><span>Define services and pricing</span></li>
          <li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#EDEDED] mt-2"></span><span>Establish resourcing and performance management</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="fade-in group border-t border-white/5 pt-12" style="animation-delay: 0.4s;">
    <div class="flex flex-col md:flex-row gap-8 md:gap-24">
      <div class="md:w-48 flex-shrink-0 pt-1"><span class="text-xs font-medium text-[#52525B] uppercase tracking-wider">Result</span></div>
      <div class="w-full space-y-8">
        <h2 class="text-2xl font-medium text-[#EDEDED] tracking-tight">Outcome & impact</h2>
        <ul class="space-y-3 text-[16px] text-[#A1A1AA]">
          <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#EDEDED]"></span><span>~0.5M revenue within first year</span></li>
          <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#EDEDED]"></span><span>Improved utilization and delivery predictability</span></li>
        </ul>
      </div>
    </div>
  </section>
</CaseStudyLayout>

