---
import BaseHead from '../components/BaseHead.astro';
import RevealScript from '../components/RevealScript.astro';
import '../styles/global.css';
const {
  title = 'Eivinas Norušaitis - Product Design & Leadership',
  description = 'Product design, operations, and leadership. Portfolio 2026 of Eivinas Norušaitis.',
  image
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="antialiased text-[#EDEDED] bg-[#050505]">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <RevealScript />
  </body>
  </html>

