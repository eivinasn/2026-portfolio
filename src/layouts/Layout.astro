---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
const {
  title = 'Eivinas Norušaitis - Product Design & Leadership',
  description = 'Product design, operations, and leadership. Portfolio 2026 of Eivinas Norušaitis.',
  image
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="antialiased text-[#EDEDED] bg-[#050505]">
    <slot />

    <script>
      const observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, observerOptions);
      document.querySelectorAll('.reveal-on-scroll, .reveal-opacity-only').forEach((el) => observer.observe(el));
    </script>
  </body>
  </html>

